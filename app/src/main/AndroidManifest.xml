<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ConceptMusicApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_concept"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_concept"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConceptMusic"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 多系统状态栏歌词与实况胶囊/灵动岛声明 (Flyme / HyperOS 澎湃焦点通知 / ColorOS 流体云 / Xposed LyricGetter) -->
        <meta-data
            android:name="com.meizu.flyme.status_bar_lyric"
            android:value="true" />
        <meta-data
            android:name="miui.focus.enable"
            android:value="true" />
        <meta-data
            android:name="oplus.fluid_cloud.enable"
            android:value="true" />
        <meta-data
            android:name="lyric_getter_support"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 Background Playback Service -->
        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 每日自动静默领取 VIP 守护 JobService -->
        <service
            android:name=".service.VipGuardianJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 酷狗概念版流光桌面小组件（仅暴露系统 APPWIDGET_UPDATE，自定义控制动作通过显式组件 PendingIntent 派发） -->
        <receiver
            android:name=".service.ConceptMusicWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/concept_music_widget_info" />
        </receiver>

    </application>

</manifest>
