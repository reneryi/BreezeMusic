<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 默认夜间主题 -->
    <style name="Theme.ConceptMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_window</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/concept_window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_concept</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- 强制浅色水彩浸润主题：即使手机系统在夜间模式，依然强制浅色 -->
    <style name="Theme.ConceptMusic.Light" parent="Theme.ConceptMusic">
        <item name="android:windowBackground">@drawable/bg_splash_window_light</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/concept_window_bg_light</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_icon_light</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- 强制深色幽邃微蓝主题 -->
    <style name="Theme.ConceptMusic.Dark" parent="Theme.ConceptMusic">
        <item name="android:windowBackground">@drawable/bg_splash_window_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/concept_window_bg_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_concept</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
